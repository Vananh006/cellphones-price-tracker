APP_NAME="Phone Price Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phone_price_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Crawler: chạy thủ công, chạy vòng lặp hoặc chạy schedule:work
CRAWLER_ENABLE_LIVE=true
CRAWLER_VERIFY_SSL=false
CRAWLER_TIMEOUT=25
CRAWLER_RETRY_TIMES=2
CRAWLER_RETRY_SLEEP_MS=800
CRAWLER_REQUEST_DELAY_MS=900
CRAWLER_CYCLE_LIMIT=12
CRAWLER_LOOP_INTERVAL=60

# AccessTrade: nếu chưa có deeplink thật thì hệ thống sẽ mở link gốc.
AFFILIATE_ENABLED=false
AFFILIATE_UTM_SOURCE=cellphones-price-tracker
AFFILIATE_UTM_MEDIUM=price-alert-email
AFFILIATE_UTM_CAMPAIGN=price-tracking
ACCESSTRADE_DEEP_LINK_DOMAIN=
ACCESSTRADE_PUB_ID=
ACCESSTRADE_CAMPAIGN_ID=

# Mail cảnh báo giá. Khi mới test nên để log; cấu hình SMTP thật khi muốn gửi email thật.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@price-tracker.local"
MAIL_FROM_NAME="Phone Price Tracker"

VITE_APP_NAME="Phone Price Tracker"
